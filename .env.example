DATABASE_URL=postgresql://user:password@pooled-host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/neondb?sslmode=require
DB_SSL=true
PG_MAINTENANCE_DB=neondb
PG_POOL_MAX=10
TENANT_PG_POOL_MAX=3

ZFLOW_SITE_INTEGRATION_KEY=replace-with-the-same-long-random-shared-secret
ZFLOW_APP_URL=https://app.example.com/login
TRIAL_OTP_SECRET=replace-with-a-separate-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=trials@example.com
SMTP_PASSWORD=use-an-app-password
ZFLOW_EMAIL_FROM=Z Flow <trials@example.com>
TRIAL_TEMPLATE_DB=z_flow_trial_template
